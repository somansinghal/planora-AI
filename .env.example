# ============================================================
# Planora AI – Master Environment Configuration Template
# File: .env.example
#
# ARCHITECTURAL NOTICE:
#   Planora AI uses a decoupled, static frontend on Vercel and a
#   containerized FastAPI backend on Render.
#
#   1. FRONTEND CONFIGURATION (Public Client Identifiers):
#      Because the frontend is pure static HTML, CSS, and native ES
#      modules, environment variables entered in Vercel do NOT
#      automatically exist in browser JavaScript. Frontend client
#      settings reside directly in js/firebase-config.js.
#
#   2. BACKEND CONFIGURATION (Server-Side Secrets):
#      Backend settings must be configured in backend/.env for local
#      development, and in the Render Dashboard for production.
#      NEVER place server-side secrets in frontend code.
# ============================================================

# ============================================================
# SECTION 1: BACKEND RUNTIME & SERVER CONFIGURATION
# Location: backend/.env (local) | Render Dashboard (production)
# ============================================================

# Runtime Environment ("development" or "production")
ENVIRONMENT=development

# Server Network Binding
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Permitted Frontend Client Origins (Comma-separated)
CORS_ORIGINS=https://planora-ai-india.vercel.app,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:3000

# ============================================================
# SECTION 2: FIREBASE ADMIN SDK (SERVER-SIDE ONLY)
# Location: backend/.env (local) | Render Secret Files (production)
# ============================================================

# Verified Firebase Project ID
FIREBASE_PROJECT_ID=planora-ai-india

# Path to service account JSON file.
# Local: backend/serviceAccountKey.json (ignored by git)
# Render: /etc/secrets/serviceAccountKey.json (via Render Secret Files)
FIREBASE_ADMIN_CREDENTIALS_PATH=

# Optional: Path to Google Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# SECTION 3: AI MODEL PROVIDER — GROQ (SERVER-SIDE ONLY)
# Location: backend/.env (local) | Render Environment (production)
# ============================================================

# CRITICAL SECRET: Never expose in frontend code or commit to GitHub.
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant

# Groq Cloud API Key (format: starts with 'gsk_')
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_placeholder_replace_with_your_groq_api_key

AI_REQUEST_TIMEOUT=60
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# Rate Limiting & Safety Quotas
AI_REQUESTS_PER_USER_PER_HOUR=20
MAX_REQUEST_SIZE_BYTES=1048576

# Pagination Defaults
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ============================================================
# SECTION 4: FRONTEND CLIENT CONFIGURATION (REFERENCE)
# Location: js/firebase-config.js (Browser Accessible)
#
# Note: Firebase Web API keys are client-side identifiers, NOT
# secrets. Security is enforced through Firestore Security Rules
# (firebase/firestore.rules) and Firebase Authentication.
# ============================================================

FIREBASE_API_KEY=AIzaSyA84s23Cx314Mps_SyCNDWV8fnnzHlSUvQ
FIREBASE_AUTH_DOMAIN=planora-ai-india.firebaseapp.com
FIREBASE_PROJECT_ID=planora-ai-india
FIREBASE_STORAGE_BUCKET=planora-ai-india.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=620959002862
FIREBASE_APP_ID=1:620959002862:web:74ccf3869ea2d58ff083ff

# Backend API Base URL for frontend requests:
# Local dev default:  http://localhost:8000
# Production Render:  https://planora-ai-zu63.onrender.com
FRONTEND_API_BASE_URL=https://planora-ai-zu63.onrender.com
