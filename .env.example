# ============================================================
# Planora AI – Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate values.
# NEVER commit files containing real secrets to version control.
# ============================================================

# ── Application Runtime ──────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── CORS Settings (Comma-separated allowed origins) ─────────
CORS_ORIGINS=https://planora-ai-india.vercel.app,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:3000

# ── Firebase Client Configuration (Frontend) ─────────────────
# Safe to expose in frontend browser configuration
FIREBASE_API_KEY=AIzaSyExampleKeyForPlanoraClientOnly
FIREBASE_AUTH_DOMAIN=planora-ai-prod.firebaseapp.com
FIREBASE_PROJECT_ID=planora-ai-prod
FIREBASE_STORAGE_BUCKET=planora-ai-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ── Firebase Admin SDK (Backend Server-Side ONLY) ────────────
# CRITICAL SECRET: Never expose in frontend or Git
# Option A: Path to service account JSON key file
FIREBASE_ADMIN_CREDENTIALS_PATH=
# Option B: On GCP / Cloud Run, leave empty to use Application Default Credentials (ADC)

# ── AI Model Provider (Backend Server-Side ONLY) ─────────────
# CRITICAL SECRET: Never expose in frontend code
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=gsk_exampleGroqApiKeyDoNotCommitSecretsHere
AI_REQUEST_TIMEOUT=60
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# ── Rate Limiting & Safety Quotas ───────────────────────────
AI_REQUESTS_PER_USER_PER_HOUR=20
MAX_REQUEST_SIZE_BYTES=1048576

# ── Frontend API Connection ─────────────────────────────────
FRONTEND_API_BASE_URL=http://localhost:8000
