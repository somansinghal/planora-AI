# ============================================================
# Planora AI – Backend Environment Configuration Template
# File: backend/.env.example
#
# Usage:
#   1. Copy this file to backend/.env for local development:
#      cp backend/.env.example backend/.env
#   2. Populate the required variables (GROQ_API_KEY, service account).
#   3. For production on Render: configure these variables in the
#      Render Dashboard (see docs/ENVIRONMENT_SETUP.md).
#
# SECURITY MANDATE:
#   NEVER commit real credentials, private keys, or API tokens.
#   All secrets are strictly server-side and excluded by .gitignore.
# ============================================================

# ── Application Runtime ──────────────────────────────────────
# Environment mode: "development" (enables /api/docs and dev auth fallback)
# or "production" (enforces strict token verification, disables public docs).
ENVIRONMENT=development

# Host bind address and port for the Uvicorn web server
HOST=0.0.0.0
PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── CORS Settings (Comma-separated allowed web origins) ───────
# Explicit list of frontend origins permitted to call this backend.
CORS_ORIGINS=https://planora-ai-india.vercel.app,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:3000

# ── Firebase Admin SDK (Backend Server-Side ONLY) ────────────
# CRITICAL SECRET: Never expose in frontend code or commit to GitHub.
#
# Verified Firebase Project ID for Planora AI
FIREBASE_PROJECT_ID=planora-ai-india

# Option A: Local service account file path.
# How to obtain:
#   1. Open Firebase Console: https://console.firebase.google.com/
#   2. Select project 'planora-ai-india' > Project Settings (gear icon) > Service accounts
#   3. Click 'Generate new private key' and download the JSON file
#   4. Save locally (e.g. backend/serviceAccountKey.json - ignored by git)
#   5. Provide the local path below (e.g. ./serviceAccountKey.json or absolute path)
#   6. On Render: Mount as a Secret File at /etc/secrets/serviceAccountKey.json
FIREBASE_ADMIN_CREDENTIALS_PATH=

# Option B: Google Application Default Credentials (ADC)
# If deploying on GCP / Google Cloud Run, leave FIREBASE_ADMIN_CREDENTIALS_PATH empty.
# Or specify the path to ADC credentials below:
# GOOGLE_APPLICATION_CREDENTIALS=

# ── AI Model Provider (Groq Cloud LLM) ──────────────────────
# CRITICAL SECRET: Server-side only. Never send to frontend browser.
# Provider name and model (default: llama-3.1-8b-instant on Groq)
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant

# Groq Cloud API Key (format: starts with 'gsk_')
# Obtain from: https://console.groq.com/keys
# If left empty, backend automatically falls back to offline demo mode
# with curated event plans and rule-based copilot recommendations.
GROQ_API_KEY=gsk_placeholder_replace_with_your_groq_api_key

# Request timeout in seconds for AI completion calls
AI_REQUEST_TIMEOUT=60

# Maximum token limits for AI completions
AI_MAX_TOKENS=4000

# Sampling temperature (0.0 = deterministic, 1.0 = highly creative)
AI_TEMPERATURE=0.7

# ── Rate Limiting & Safety Quotas ───────────────────────────
# Maximum AI generation / copilot requests allowed per user per hour
AI_REQUESTS_PER_USER_PER_HOUR=20

# Maximum allowed HTTP request payload size in bytes (1048576 = 1MB)
MAX_REQUEST_SIZE_BYTES=1048576

# ── Pagination Defaults ─────────────────────────────────────
# Default number of records returned per paginated query
DEFAULT_PAGE_SIZE=50

# Maximum upper bound for pagination limit query parameter
MAX_PAGE_SIZE=200
