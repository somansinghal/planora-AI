# ============================================================
# Planora AI – Backend Environment Configuration Template
# Copy this file to backend/.env for local backend execution.
# NEVER commit files containing real secrets to version control.
# ============================================================

# ── Application Runtime ──────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── CORS Origins (Comma-separated allowed web clients) ───────
CORS_ORIGINS=https://planora-ai-india.vercel.app,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:3000

# ── Firebase Admin SDK (Server-Side ONLY) ───────────────────
# CRITICAL SECRET: Never expose in frontend or Git.
# Option A: Path to service account JSON key file (e.g. ./serviceAccountKey.json)
FIREBASE_ADMIN_CREDENTIALS_PATH=
# Option B: On GCP / Cloud Run, leave path empty to use Application Default Credentials (ADC)
FIREBASE_PROJECT_ID=planora-ai

# ── AI Model Provider (Groq Cloud LLM) ──────────────────────
# CRITICAL SECRET: Server-side only. Never send to frontend browser.
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=gsk_exampleGroqApiKeyDoNotCommitSecretsHere
AI_REQUEST_TIMEOUT=60
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# ── Rate Limiting & Safety Quotas ───────────────────────────
AI_REQUESTS_PER_USER_PER_HOUR=20
MAX_REQUEST_SIZE_BYTES=1048576

# ── Pagination Defaults ─────────────────────────────────────
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
